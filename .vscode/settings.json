{
    "files.exclude": {
        "**/.DS_Store": true,
        "**/.git": true,
        "**/.gitmodules": true,
        "**/*.booproj": true,
        "**/*.pidb": true,
        "**/*.suo": true,
        "**/*.user": true,
        "**/*.userprefs": true,
        "**/*.unityproj": true,
        "**/*.dll": true,
        "**/*.exe": true,
        "**/*.pdf": true,
        "**/*.mid": true,
        "**/*.midi": true,
        "**/*.wav": true,
        "**/*.gif": true,
        "**/*.ico": true,
        "**/*.jpg": true,
        "**/*.jpeg": true,
        "**/*.png": true,
        "**/*.psd": true,
        "**/*.tga": true,
        "**/*.tif": true,
        "**/*.tiff": true,
        "**/*.3ds": true,
        "**/*.3DS": true,
        "**/*.fbx": true,
        "**/*.FBX": true,
        "**/*.lxo": true,
        "**/*.LXO": true,
        "**/*.ma": true,
        "**/*.MA": true,
        "**/*.obj": true,
        "**/*.OBJ": true,
        "**/*.asset": true,
        "**/*.cubemap": true,
        "**/*.flare": true,
        "**/*.mat": true,
        "**/*.meta": true,
        "**/*.prefab": true,
        "**/*.unity": true,
        "build/": true,
        "Build/": true,
        "Library/": true,
        "library/": true,
        "obj/": true,
        "Obj/": true,
        "ProjectSettings/": true,
        "temp/": true,
        "Temp/": true
    },
    "dotnet.defaultSolution": "MagicPals.sln",
    "editor.tokenColorCustomizations": {
        "textMateRules": [
            {
                "scope": [
                    "variable.other.object.property.cs",
                ],
                "settings": {
                    "foreground": "#9ffdea",
                },
            },
            {
                "scope": [
                    "variable.other.readwrite.cs",
                ],
                "settings": {
                    "foreground": "#9CDCFE",
                },
            },
            {
                "scope": [
                    "entity.name.type.cs",
                ],
                "settings": {
                    "foreground": "#4EC9B0",
                },
            },
            {
                "scope": [
                    "variable.other.object.cs",
                ],
                "settings": {
                    "foreground": "#4EC9B0",
                },
            },
            {
                "scope": [
                    "entity.name.function.cs",
                ],
                "settings": {
                    "foreground": "#dcd0aa",
                },
            },
            {
                "scope": [
                    "entity.name.variable.local.cs",
                ],
                "settings": {
                    "foreground": "#cacaca",
                },
            },
            {
                "scope": [
                    "constant.numeric.decimal.cs",
                ],
                "settings": {
                    "foreground": "#b5cea8",
                },
            },
        ],
    },
}